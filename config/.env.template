# System Monitoring Configuration
# Copy this file to /etc/system-monitoring/.env and customize

# n8n Webhook URL (REQUIRED)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/system-monitoring

# JWT Authentication Passphrase (REQUIRED for JWT auth)
# Use the same passphrase configured in your n8n JWT Auth account
JWT_PASSPHRASE=your-jwt-passphrase-here

# Lookback window in minutes (default: 60)
LOOKBACK_MINUTES=60
